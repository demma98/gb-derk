DEF IN_START  EQU %10000000
DEF IN_SELECT EQU %01000000
DEF IN_B      EQU %00100000
DEF IN_A      EQU %00010000
DEF IN_DOWN   EQU %00001000
DEF IN_UP     EQU %00000100
DEF IN_LEFT   EQU %00000010
DEF IN_RIGHT  EQU %00000001

DEF INPUT_MEMORY  EQU $FF80
DEF INPUT_C   EQU INPUT_MEMORY + $00
DEF INPUT_N   EQU INPUT_MEMORY + $01

DEF WAIT_T    EQU $FF88
DEF SKIP_L    EQU $FF89

DEF COPY_HIGH    EQU $FF8A
DEF COPY_LOW  EQU $FF8B

DEF hFADE_DATA   EQU $FF90
DEF FADE_C    EQU hFADE_DATA + $00
DEF FADE_T    EQU hFADE_DATA + $01
DEF FADE_T_L  EQU hFADE_DATA + $02
DEF FADE_C_SET  EQU $04
DEF FADE_T_SET  EQU $01


DEF wBOARD_DATA      EQU $C000
DEF wBOARD_DATA_END  EQU $B000
DEF hBOARD_INFO   EQU $FFC0
DEF BOARD_LEVEL   EQU hBOARD_INFO + $00
DEF BOARD_WIDTH   EQU hBOARD_INFO + $01
DEF BOARD_HEIGHT  EQU hBOARD_INFO + $02
DEF BOARD_TEMP    EQU hBOARD_INFO + $03
  ; offsetf of the board
DEF BOARD_X_OFF   EQU hBOARD_INFO + $04  ; offsets in pixels for scroll
DEF BOARD_Y_OFF   EQU hBOARD_INFO + $05

